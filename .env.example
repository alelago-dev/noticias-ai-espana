# Opcional: activa síntesis y consultas con IA. Sin estas variables funciona
# la selección de noticias, el boletín extractivo y la búsqueda de fuentes.
AI_GATEWAY_API_KEY=
# Copiar un ID actual de https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=openai/gpt-6-luna
PORT=3000

# Opcional: informativo de radio con voz neuronal (capas gratuitas).
# Voz: Azure Speech. Guion: Gemini (o AI_GATEWAY_* arriba).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
GEMINI_API_KEY=
# Opcional. Por defecto gemini-3.5-flash-lite y, si da 404, gemini-3.8-flash.
# Los proyectos nuevos ya no pueden usar gemini-2.5-* aunque models.list los muestre.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: clave para firmar los fragmentos de audio (si no, se usa AZURE_SPEECH_KEY)
# AUDIO_SIGNING_SECRET=
